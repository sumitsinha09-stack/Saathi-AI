# PostgreSQL Database Configuration
POSTGRES_DB=samaran
POSTGRES_USER=samaran_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://samaran_user:your_secure_password_here@127.0.0.1:5433/samaran

# Backend Application Settings
APP_NAME="Saathi AI - Cybercrime Reporting Assistant"
APP_ENV=development
APP_PORT=8000
SECRET_KEY=generate_a_random_32_byte_hex_key

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Faster-Whisper Speech Recognition Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# WhatsApp Cloud API & Meta Configuration
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0
