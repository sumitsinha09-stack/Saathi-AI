# PostgreSQL Database Configuration
POSTGRES_DB=samaran
POSTGRES_USER=samaran_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://samaran_user:your_secure_password_here@127.0.0.1:5433/samaran

# Backend Application Settings
APP_NAME="Saathi AI - Cybercrime Reporting Assistant"
APP_ENV=development
APP_PORT=8000
SECRET_KEY=generate_a_random_32_byte_hex_key

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Faster-Whisper Speech Recognition Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# WhatsApp Cloud API & Meta Configuration
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

# Voice Recording & Audio Upload Configuration
VOICE_UPLOAD_DIR=backend/storage/voice_notes
MAX_AUDIO_SIZE_BYTES=5242880
MAX_AUDIO_DURATION_SECONDS=120.0
VOICE_RETENTION_HOURS=24

# Local Translation Configuration (Indic to English)
# Engines: ollama (recommended), argostranslate, auto
TRANSLATION_ENGINE=ollama
TRANSLATION_MODEL=qwen2.5:3b
TRANSLATION_TIMEOUT_SECONDS=30.0

